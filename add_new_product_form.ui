       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_dims">
         <property name="text">
          <string>Габариты (Д×Ш×В), см</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1" colspan="2">
        <layout class="QHBoxLayout" name="hbox_dims">
         <item>
          <widget class="QLineEdit" name="lineEdit_dim_x">
           <property name="placeholderText">
            <string>Д</string>
