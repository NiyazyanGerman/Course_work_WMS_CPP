          <string/>
         </property>
        </widget>
       </item>
       <item row="4" column="0" colspan="3">
        <widget class="QLabel" name="label_title_pallet">
         <property name="text">
          <string>Условия хранения</string>
         </property>
         <property name="role" stdset="0">
          <string>section_title</string>
         </property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="label_pallet_type">
         <property name="text">
