       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="label_barcode">
         <property name="text">
          <string>Штрихкод</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1" colspan="2">
        <widget class="QLineEdit" name="lineEdit_barcode">
         <property name="placeholderText">
          <string/>
         </property>
        </widget>
       </item>
       <item row="7" column="0" colspan="2">
        <widget class="QLabel" name="label_barcode_preview">
         <property name="text">
          <string/>
         </property>
        </widget>
       </item>
       <item row="7" column="2">
        <widget class="QPushButton" name="btn_print_barcode">
         <property name="text">
          <string>Печать ШК</string>
         </property>
        </widget>
       </item>
       <item row="8" column="0" colspan="3">
        <spacer name="verticalSpacer_main">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_logistics">
      <attribute name="title">
       <string>2. Логистика и Габариты</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_logistics">
       <item row="0" column="0" colspan="3">
        <widget class="QLabel" name="label_title_logistics">
         <property name="text">
          <string>Физические параметры</string>
         </property>
         <property name="role" stdset="0">
