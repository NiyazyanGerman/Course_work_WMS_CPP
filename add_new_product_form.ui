        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="label_unit">
         <property name="text">
          <string>Базовая единица *</string>
         </property>
        </widget>
       </item>
       <item row="5" column="1" colspan="2">
        <widget class="QComboBox" name="comboBox_unit">
         <item>
          <property name="text">
