        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_sku">
         <property name="text">
          <string>SKU (артикул) *</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QLineEdit" name="lineEdit_sku">
         <property name="placeholderText">
          <string/>
         </property>
        </widget>
       </item>
       <item row="3" column="2">
        <widget class="QPushButton" name="btn_auto_sku">
         <property name="text">
          <string>Авто SKU</string>
         </property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="label_category">
         <property name="text">
          <string>Категория</string>
         </property>
        </widget>
       </item>
       <item row="4" column="1" colspan="2">
        <widget class="QComboBox" name="comboBox_category">
         <property name="editable">
          <bool>true</bool>
         </property>
         <item>
          <property name="text">
           <string>Не указана</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Диски</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Шины</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Масла и жидкости</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Аксессуары</string>
          </property>
