         </property>
        </widget>
       </item>
       <item row="5" column="1" colspan="2">
        <widget class="QComboBox" name="comboBox_pallet">
         <item>
          <property name="text">
           <string>Не указано</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>EUR-паллета (800x1200)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>FIN-паллета (1000x1200)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>USA-паллета (1200x1200)</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="label_temp">
         <property name="text">
          <string>Температурный режим</string>
         </property>
        </widget>
       </item>
       <item row="6" column="1" colspan="2">
        <widget class="QComboBox" name="comboBox_temp">
         <item>
          <property name="text">
           <string>Обычный (+5...+25)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Холод (-18...0)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Морозилка (ниже -18)</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="7" column="0" colspan="3">
        <spacer name="verticalSpacer_logistics">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
