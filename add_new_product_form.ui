<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>add_new_product_form</class>
 <widget class="QDialog" name="add_new_product_form">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>680</width>
    <height>550</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Добавить товар на ответственное хранение</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ===== БАЗА ===== */
QWidget {
    font: 10pt &quot;Segoe UI&quot;;
    color: #e8e8e8;
    background: #1e1e1e;
}
QDialog { background: #1e1e1e; }

/* ===== ВКЛАДКИ ===== */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    background: #252525;
    top: -1px;
}
QTabBar::tab {
    background: #2a2a2a;
    color: #8a8a8a;
    border: 1px solid #3a3a3a;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    margin-right: 4px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: #252525;
    color: #4a9eff;
    border-bottom: 1px solid #252525;
}
QTabBar::tab:hover:!selected {
    background: #3a3a3a;
    color: #e8e8e8;
}

/* ===== ПОДПИСИ ===== */
QLabel {
    background: transparent;
    color: #e8e8e8;
    padding: 2px 0;
}
QLabel[role=&quot;section_title&quot;] {
    color: #4a9eff;
    font-weight: bold;
    font-size: 11pt;
    margin-top: 10px;
    margin-bottom: 5px;
}
QLabel[role=&quot;hint&quot;] {
    color: #8a8a8a;
    font-style: italic;
    font-size: 9pt;
}

/* ===== ПОЛЯ ВВОДА ===== */
QLineEdit, QComboBox {
    background: #2a2a2a;
    color: #e8e8e8;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover { border-color: #4a4a4a; }
QLineEdit:focus, QComboBox:focus { border-color: #4a9eff; background: #252525; }

/* ===== КНОПКИ ===== */
QPushButton {
    background: #3a3a3a;
    color: #e8e8e8;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    padding: 7px 18px;
    font: 600 10pt &quot;Segoe UI&quot;;
}
QPushButton:hover { background: #454545; border-color: #5a5a5a; }
QPushButton:pressed { background: #2a2a2a; }
QPushButton[role=&quot;accent&quot;] { background: #4a9eff; color: #ffffff; border: none; }
QPushButton[role=&quot;accent&quot;]:hover { background: #5aaeff; }
QPushButton[role=&quot;accent&quot;]:pressed { background: #3a8eef; }

/* ===== DIALOGBUTTONBOX ===== */
QDialogButtonBox QPushButton { min-width: 90px; }
</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayoutMain">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab_main">
      <attribute name="title">
       <string>1. Основное</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_main">
       <item row="0" column="0" colspan="3">
        <widget class="QLabel" name="label_title_main">
         <property name="text">
          <string>Идентификация груза</string>
         </property>
         <property name="role" stdset="0">
          <string>section_title</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_client">
         <property name="text">
          <string>Клиент (Владелец) *</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1" colspan="2">
        <widget class="QLineEdit" name="lineEdit_client">
         <property name="placeholderText">
          <string/>
         </property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_name">
         <property name="text">
          <string>Наименование товара *</string>
