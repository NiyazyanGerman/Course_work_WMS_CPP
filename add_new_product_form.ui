       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_weight">
         <property name="text">
          <string>Вес 1 ед., кг</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1" colspan="2">
        <widget class="QLineEdit" name="lineEdit_weight">
         <property name="placeholderText">
