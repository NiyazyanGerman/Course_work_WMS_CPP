     </widget>
     <widget class="QWidget" name="tab_tariffs">
      <attribute name="title">
       <string>3. Тарифы</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_tariffs">
       <item row="0" column="0" colspan="3">
        <widget class="QLabel" name="label_title_tariffs">
         <property name="text">
          <string>Коммерческие условия (3PL)</string>
         </property>
         <property name="role" stdset="0">
          <string>section_title</string>
         </property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_tariff_group">
         <property name="text">
          <string>Группа тарифов</string>
         </property>
        </widget>
       </item>
       <item row="1" column="1" colspan="2">
        <widget class="QComboBox" name="comboBox_tariff_group">
         <item>
          <property name="text">
           <string>Стандарт (обычный)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Крупногабарит (сложные)</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Ценный груз</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_storage_price">
         <property name="toolTip">
          <string>Сколько вы берете с клиента за хранение одной паллеты в сутки</string>
         </property>
         <property name="text">
          <string>Тариф хранения, руб/сутки *</string>
         </property>
        </widget>
       </item>
       <item row="2" column="1" colspan="2">
        <widget class="QLineEdit" name="lineEdit_storage_price">
         <property name="placeholderText">
          <string/>
         </property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_handling_price">
         <property name="toolTip">
          <string>Стоимость разгрузки/погрузки одной паллеты</string>
         </property>
         <property name="text">
          <string>Тариф погрузки, руб/паллета</string>
         </property>
        </widget>
       </item>
       <item row="3" column="1" colspan="2">
        <widget class="QLineEdit" name="lineEdit_handling_price">
         <property name="placeholderText">
          <string/>
         </property>
        </widget>
       </item>
       <item row="4" column="0" colspan="3">
        <widget class="QLabel" name="label_title_flags">
         <property name="text">
          <string>Особенности учёта</string>
         </property>
         <property name="role" stdset="0">
          <string>section_title</string>
         </property>
        </widget>
       </item>
       <item row="5" column="0" colspan="3">
        <layout class="QHBoxLayout" name="hbox_flags">
         <item>
          <widget class="QCheckBox" name="checkBox_serial">
           <property name="text">
            <string>Серийный учёт</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="checkBox_batch">
           <property name="text">
            <string>Партионный учёт</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="checkBox_fragile">
           <property name="text">
            <string>Хрупкий груз</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="6" column="0" colspan="3">
        <widget class="QLabel" name="label_hint_tariff">
         <property name="text">
          <string>Примечание: Тарифы могут быть изменены вручную в договоре. Эти значения используются для автоматического выставления счетов.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="role" stdset="0">
          <string>hint</string>
         </property>
        </widget>
       </item>
       <item row="7" column="0" colspan="3">
        <spacer name="verticalSpacer_tariffs">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Orientation::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>add_new_product_form</receiver>
   <slot>accept()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>add_new_product_form</receiver>
   <slot>reject()</slot>
   <hints>
    <hint type="sourcelabel">
     <x>20</x>
     <y>20</y>
    </hint>
    <hint type="destinationlabel">
     <x>20</x>
     <y>20</y>
    </hint>
   </hints>
  </connection>
 </connections>
</ui>
