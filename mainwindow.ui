             <item row="3" column="0"><widget class="QLabel" name="lbl_usa"><property name="text"><string>USA (1200x1200):</string></property><property name="role" stdset="0"><string>topo_lbl</string></property></widget></item>
             <item row="3" column="1"><widget class="QSpinBox" name="spin_usa_total"><property name="maximum"><number>99999</number></property><property name="value"><number>20</number></property></widget></item>
