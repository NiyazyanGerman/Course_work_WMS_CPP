     <attribute name="title">
      <string>[1] Номенклатура </string>
     </attribute>
     <layout class="QVBoxLayout" name="verticalLayout_tab1">
      <item>
       <widget class="QTableWidget" name="tableWidget">
        <property name="alternatingRowColors"><bool>true</bool></property>
