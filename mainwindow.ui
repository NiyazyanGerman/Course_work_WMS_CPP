             <item row="2" column="1"><widget class="QSpinBox" name="spin_fin_total"><property name="maximum"><number>99999</number></property><property name="value"><number>40</number></property></widget></item>
             <item row="2" column="2"><widget class="QSpinBox" name="spin_fin_work"><property name="maximum"><number>99999</number></property><property name="value"><number>40</number></property></widget></item>
             <item row="2" column="3"><widget class="QSpinBox" name="spin_fin_broken"><property name="maximum"><number>99999</number></property><property name="value"><number>0</number></property></widget></item>

