       <layout class="QHBoxLayout" name="horizontalLayout_buttons">
        <item><spacer name="horizontalSpacer"><property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        <item><widget class="QPushButton" name="btn_add_new_product"><property name="minimumSize"><size><width>181</width><height>41</height></size></property><property name="text"><string>Добавить новый товар</string></property></widget></item>
