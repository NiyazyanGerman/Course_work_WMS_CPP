<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1028</width>
    <height>650</height> <!-- Немного увеличили высоту под новые формы -->
   </rect>
  </property>
  <property name="windowTitle">
   <string>MainWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QTabWidget::pane {
    border: 2px solid #8a9a5b;
    border-radius: 6px;
    background: #f7f4ec;
    top: -2px;
}
QTabBar { background: transparent; }
QTabBar::tab {
    background: #e9e3d3;
    color: #4a4a3f;
    border: 2px solid #c9c2ad;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 22px;
    margin-right: 4px;
    min-width: 90px;
    font: 600 10pt &quot;Segoe UI&quot;;
    letter-spacing: 0.5px;
}
QTabBar::tab:hover {
    background: #f0ebde;
    border-color: #8a9a5b;
    color: #3a3a30;
}
QTabBar::tab:selected {
    background: #f7f4ec;
    color: #2f3a1a;
    border-color: #8a9a5b;
    border-left: 5px solid #c9752f;
    padding-left: 19px;
}
QTabBar::tab:!selected { margin-top: 4px; }
QWidget {
    background: #f7f4ec;
    color: #33332b;
    font: 10pt &quot;Segoe UI&quot;;
}
QPushButton {
    background: #8a9a5b;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 16px;
    font-weight: 600;
}
QPushButton:hover  { background: #7a8a4b; }
QPushButton:pressed { background: #6a7a3b; }

/* Стили для вкладки Топологии */
QGroupBox {
    background: #ffffff;
    border: 1px solid #c9c2ad;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 15px;
    font-weight: bold;
    color: #2f3a1a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
}
QLabel[role=&quot;topo_lbl&quot;] {
    font-weight: normal;
    color: #4a4a3f;
}

/* Стили для кнопок отчетов */
QPushButton[role=&quot;report_btn&quot;] {
    background: transparent;
    color: #33332b;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    text-align: left;
    font-weight: normal;
}
QPushButton[role=&quot;report_btn&quot;]:hover {
    background: #e9e3d3;
    border-color: #c9c2ad;
    color: #2f3a1a;
}
QPushButton[role=&quot;report_btn&quot;]:pressed {
    background: #c9752f;
    color: #ffffff;
}
QLabel[role=&quot;group_title&quot;] {
    font-weight: bold;
    color: #8a9a5b;
    margin-top: 10px;
    margin-bottom: 2px;
    font-size: 11pt;
}

QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background: #ffffff;
    border: 1px solid #c9c2ad;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #c9752f;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #8a9a5b; }

QHeaderView::section {
    background: #e9e3d3;
    color: #4a4a3f;
    border: 1px solid #c9c2ad;
    padding: 6px;
    font-weight: 600;
}
QTableView, QTableWidget {
    background: #ffffff;
    alternate-background-color: #f4f1e6;
    gridline-color: #ddd6c2;
    selection-background-color: #c9752f;
    selection-color: #ffffff;
}</string>
  </property>
  <widget class="QWidget" name="centralwidget">
