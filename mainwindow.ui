      <item>
       <widget class="QFrame" name="frame_report_viewer">
        <property name="styleSheet"><string notr="true">QFrame { background: #ffffff; border: 1px solid #c9c2ad; border-radius: 4px; }</string></property>
        <property name="frameShape"><enum>QFrame::Shape::StyledPanel</enum></property>
